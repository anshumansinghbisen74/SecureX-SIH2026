BLOCKCHAIN_PRIVATE_KEY=
CONTRACT_ADDRESS=
REFRESH_TOKEN_EXPIRE_DAYS=7
TESSERACT_CMD=
DEMO_SEED_ENABLED=false
DEMO_ADMIN_PASSWORD=
DEMO_INVESTIGATOR_PASSWORD=
DEMO_OFFICER_PASSWORD=
DEMO_VIEWER_PASSWORD=
REQUIRE_HTTPS=false
LLM_PROVIDER=local
LLM_ENDPOINT=
LLM_API_KEY=
